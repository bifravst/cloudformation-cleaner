{
  "name": "@bifravst/cloudformation-cleaner",
  "version": "0.0.0-development",
  "description": "Cleans old CloudFormation stacks and log groups, e.g. from CI runs",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "prepare": "husky && case \"$npm_command\" in install|ci) check-node-version --package ;; esac",
    "clean": "node --no-warnings --experimental-transform-types ./cli.ts"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bifravst/cloudformation-cleaner.git"
  },
  "keywords": [
    "aws",
    "cloudformation"
  ],
  "author": "Nordic Semiconductor ASA | nordicsemi.no",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/bifravst/cloudformation-cleaner/issues"
  },
  "homepage": "https://github.com/bifravst/cloudformation-cleaner#readme",
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "3.1124.0",
    "@aws-sdk/client-cloudwatch-logs": "3.1124.0",
    "@aws-sdk/client-iam": "3.1124.0",
    "@aws-sdk/client-lambda": "3.1124.0",
    "@aws-sdk/client-s3": "3.1124.0",
    "@aws-sdk/client-ssm": "3.1124.0",
    "@bifravst/aws-cdk-lambda-helpers": "5.0.5",
    "@bifravst/eslint-config-typescript": "8.0.3",
    "@bifravst/prettier-config": "2.0.0",
    "@commitlint/config-conventional": "21.2.2",
    "@types/glob": "9.0.0",
    "@types/node": "26.4.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "aws-cdk-lib": "2.265.0",
    "cdk": "2.1139.0",
    "check-node-version": "4.2.1",
    "commitlint": "21.2.2",
    "constructs": "10.8.1",
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "lint-staged": {
    "*.{md,json,yaml,yml}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint"
    ]
  },
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=12.0.2 <13"
  },
  "release": {
    "branches": [
      "saga"
    ],
    "remoteTags": true,
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/github",
        {
          "successCommentCondition": false,
          "failTitle": false
        }
      ]
    ]
  },
  "dependencies": {
    "@bifravst/cloudformation-helpers": "10.0.1",
    "@bifravst/from-env": "4.0.0"
  },
  "prettier": "@bifravst/prettier-config"
}
